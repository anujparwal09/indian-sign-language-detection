# Streamlit Configuration for Deployment
# Place this in .streamlit/secrets.toml (create it locally, never commit to GitHub)
# Only needed if you have API keys or sensitive data

# Example:
# [database]
# url = "postgresql://user:password@localhost/dbname"
# [api_keys]
# openai = "sk-..."
# huggingface = "hf_..."

# For this project, no secrets are needed initially
# All configuration is in config.toml
